# Salin ke .env lalu isi. JANGAN commit .env. chmod 600 .env

# --- Wajib ---
# openssl rand -hex 32
JWT_SECRET=
# Dari dashboard Cloudflare (string panjang setelah --token), lihat README bagian Cloudflare Tunnel
TUNNEL_TOKEN=

# --- API key kelompok mitra: satu key per kelompok (nama:key,nama2:key2). key: openssl rand -hex 16 ---
API_KEYS=siaran-belajar:GANTI_KEY_1,materi-belajar:GANTI_KEY_2
PARTNER_RATE_PER_MIN=60

# --- Aturan domain ---
FREE_DAILY_QUOTA=5
MAX_ATTEMPTS=3
# true = tombol upgrade/downgrade Pro berupa simulasi (untuk demo). false = nonaktif.
SUBSCRIPTION_SIMULATION=true
JWT_TTL_SECONDS=3600

# --- Layanan AI eksternal ---
# mock = dev/test saja. Untuk demo/penilaian pakai http (API kompatibel OpenAI chat completions).
AI_PROVIDER=mock
AI_API_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT=30

# --- Integrasi kelompok mitra (ACL), isi saat kontrak API mitra sudah ada di API Registry ---
PARTNERS_ENABLED=false
PARTNER_TIMEOUT=4
PARTNER_CACHE_TTL=300
PARTNER_SIARAN_BASE_URL=
PARTNER_SIARAN_PATH=/sessions?topic={topic}
PARTNER_SIARAN_API_KEY=
PARTNER_MATERI_BASE_URL=
PARTNER_MATERI_PATH=/materials?topic={topic}
PARTNER_MATERI_API_KEY=
