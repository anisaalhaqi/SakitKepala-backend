# URL microservice SakitKepala, sudah termasuk /api.
#   Live (dipakai APK):      https://sakitkepala.stei.site/api
#   Lokal, emulator Android: http://10.0.2.2:8080/api
#   Lokal, HP fisik:         http://<IP LAN komputer>:8080/api
EXPO_PUBLIC_API_URL=https://sakitkepala.stei.site/api

# Layanan integrasi (ACL ke Sistem Siaran Belajar & Sistem Materi Belajar).
# Kosongkan bila ACL masih berjalan di microservice yang sama.
