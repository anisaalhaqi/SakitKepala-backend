  "components": {
    "schemas": {
      "CheckpointIn": {
        "properties": {
          "summary": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 30,
            "title": "Summary"
          }
        },
        "type": "object",
        "required": [
          "summary"
        ],
        "title": "CheckpointIn"
      },
      "CheckpointOut": {
        "properties": {
          "passed": {
            "type": "boolean",
            "title": "Passed"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "attempts_left": {
            "type": "integer",
            "title": "Attempts Left"
          },
          "locked_final": {
            "type": "boolean",
            "title": "Locked Final"
          },
          "feedback": {
            "type": "string",
            "title": "Feedback"
          },
          "final_result": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Final Result"
          },
          "export_enabled": {
            "type": "boolean",
            "title": "Export Enabled"
          }
        },
        "type": "object",
        "required": [
          "passed",
          "status",
          "attempts_left",
          "locked_final",
          "feedback",
          "export_enabled"
        ],
        "title": "CheckpointOut"
      },
      "Credentials": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Credentials"
      },
      "ExportOut": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "topic": {
            "type": "string",
            "title": "Topic"
          },
          "question": {
            "type": "string",
            "title": "Question"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation"
          },
          "final_result": {
            "type": "string",
            "title": "Final Result"
          },
          "understanding_notes": {
            "type": "string",
            "title": "Understanding Notes"
          },
          "proof_of_learning": {
            "$ref": "#/components/schemas/ProofOut"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "topic",
          "question",
          "explanation",
          "final_result",
          "understanding_notes",
          "proof_of_learning"
        ],
        "title": "ExportOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MeOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "tier": {
            "type": "string",
            "title": "Tier"
          }
        },
        "type": "object",
        "required": [
          "id",
          "email",
          "tier"
        ],
        "title": "MeOut"
      },
      "PartnerBlock": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "items": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "status",
          "items"
        ],
        "title": "PartnerBlock"
      },
      "ProofOut": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "topic": {
            "type": "string",
            "title": "Topic"
          },
          "attempt_no": {
            "type": "integer",
            "title": "Attempt No"
          },
          "passed_at": {
            "type": "string",
            "title": "Passed At"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "topic",
          "attempt_no",
          "passed_at"
        ],
        "title": "ProofOut"
      },
      "QaItem": {
        "properties": {
          "question": {
            "type": "string",
            "title": "Question"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          }
        },
        "type": "object",
        "required": [
          "question",
          "answer"
        ],
        "title": "QaItem"
      },
      "QaOut": {
        "properties": {
          "contract_version": {
            "type": "string",
            "title": "Contract Version",
            "default": "1.0"
          },
          "topic": {
            "type": "string",
            "title": "Topic"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/QaItem"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "topic",
          "count",
          "items"
        ],
        "title": "QaOut"
      },
      "QuestionsOut": {
        "properties": {
          "contract_version": {
            "type": "string",
            "title": "Contract Version",
            "default": "1.0"
          },
          "topic": {
            "type": "string",
            "title": "Topic"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          },
          "questions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Questions"
          }
        },
        "type": "object",
        "required": [
          "topic",
          "count",
          "questions"
        ],
        "title": "QuestionsOut"
      },
      "QuotaStatus": {
        "properties": {
          "tier": {
            "type": "string",
            "title": "Tier"
          },
          "limit": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Limit"
          },
          "used": {
            "type": "integer",
            "title": "Used"
          },
          "remaining": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Remaining"
          }
        },
        "type": "object",
        "required": [
          "tier",
          "limit",
          "used",
          "remaining"
        ],
        "title": "QuotaStatus"
      },
      "ReferencesOut": {
        "properties": {
          "topic": {
            "type": "string",
            "title": "Topic"
          },
          "live_sessions": {
            "$ref": "#/components/schemas/PartnerBlock"
          },
          "materials": {
            "$ref": "#/components/schemas/PartnerBlock"
          }
        },
        "type": "object",
        "required": [
